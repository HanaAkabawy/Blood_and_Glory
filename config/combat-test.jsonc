{
    "start-scene": "play",
    "window": {
        "title": "Blood and Glory - Combat Test (App-based Layout)",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/sepia.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "smile": "assets/textures/smile.png"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj"
            },
            "samplers": {
                "default": {}
            },
            "materials": {
                "ground": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": false },
                        "depthTesting": { "enabled": true }
                    },
                    "tint": [1, 1, 1, 1],
                    "texture": "grass",
                    "sampler": "default"
                },
                "player": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "texture": "smile",
                    "sampler": "default",
                    "tint": [0.3, 0.6, 1.0, 1.0]
                },
                "enemy": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "tint": [1.0, 0.2, 0.2, 1.0]
                },
                "wall": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "texture": "wood",
                    "sampler": "default",
                    "tint": [0.7, 0.5, 0.3, 1.0]
                },
                "orbit_cam_target": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "tint": [0.0, 1.0, 1.0, 1.0]
                }
            }
        },
        "world": [
            // Fixed Camera (angled view of the arena) - DISABLED to use Orbit Camera with zoom
            // {
            //     "name": "Fixed Camera",
            //     "position": [0, 15, 20],
            //     "rotation": [-30, 0, 0],
            //     "components": [
            //         { "type": "Camera" }
            //     ]
            // },
            // Orbit Camera (follows the player for combat with zoom support)
            {
                "name": "Orbit Camera",
                "position": [0, 10, 15],
                "rotation": [0, 0, 0],
                "components": [
                    { "type": "Camera" },
                    { 
                        "type": "Orbit Camera Controller", 
                        "target": "Player", 
                        "distance": 15.0, 
                        "pitch": 45.0, 
                        "yaw": 0.0,
                        "zoomSensitivity": 2.0,
                        "minDistance": 5.0,
                        "maxDistance": 30.0 
                    }
                ]
            },
            
            // GROUND (using plane like in app.jsonc)
            {
                "name": "Ground",
                "position": [0, -1, 0],
                "rotation": [-90, 0, 0],
                "scale": [30, 30, 1],
                "components": [
                    { 
                        "type": "Mesh Renderer", 
                        "mesh": "plane", 
                        "material": "ground" 
                    }
                ]
            },
            
            // PLAYER (positioned on the ground at y=0, since ground plane is at y=-1)
            {
                "name": "Player",
                "position": [0, 0, 0],
                "scale": [2, 2, 2],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "player" },
                    { 
                        "type": "Player Controller", 
                        "movementSpeed": 10.0, 
                        "rotationSpeed": 10.0, 
                        "sprintMultiplier": 1.5 
                    },
                    { 
                        "type": "Collision", 
                        "radius": 2.0, 
                        "isStatic": false, 
                        "canCollideWithWalls": true, 
                        "canCollideWithEnemies": true 
                    },
                    { "type": "Health", "maxHealth": 100.0, "currentHealth": 100.0 },
                    { 
                        "type": "Click Attack", 
                        "damage": 25.0,
                        "range": 5.0,
                        "attackCooldown": 0.5
                    }
                ]
            },
            
            // ENEMY 1 (red ball with AI)
            {
                "name": "Enemy 1",
                "position": [5, 0.5, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "enemy" },
                    { 
                        "type": "Enemy AI", 
                        "detectionRange": 10.0, 
                        "loseTargetRange": 15.0, 
                        "moveSpeed": 3.0, 
                        "attackRange": 3.0, 
                        "attackDamage": 10.0, 
                        "attackCooldown": 1.5, 
                        "initialState": "IDLE", 
                        "idleTime": 1.0,
                        "patrolPoint": [10, 0.5, 0]
                    },
                    { 
                        "type": "Collision", 
                        "radius": 1.5, 
                        "isStatic": false, 
                        "canCollideWithWalls": true, 
                        "canCollideWithPlayer": true 
                    },
                    { "type": "Health", "maxHealth": 50.0, "currentHealth": 50.0, "destroyOnDeath": true }
                ]
            },
            
            // ENEMY 2 (red ball with AI)
            {
                "name": "Enemy 2",
                "position": [-5, 1, 0],
                "scale": [2, 2, 2],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "enemy" },
                    { 
                        "type": "Enemy AI", 
                        "detectionRange": 12.0, 
                        "loseTargetRange": 18.0, 
                        "moveSpeed": 4.0, 
                        "attackRange": 4.0,
                        "attackDamage": 15.0, 
                        "attackCooldown": 1.0, 
                        "patrolPoint": [-10, 1, 0],
                        "initialState": "IDLE"
                    },
                    { 
                        "type": "Collision", 
                        "radius": 2.0, 
                        "isStatic": false, 
                        "canCollideWithWalls": true, 
                        "canCollideWithPlayer": true 
                    },
                    { "type": "Health", "maxHealth": 75.0, "currentHealth": 75.0, "destroyOnDeath": true }
                ]
            },
            
            // ENEMY 3 (red ball with AI)
            {
                "name": "Enemy 3",
                "position": [0, 0.75, 8],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "enemy" },
                    { 
                        "type": "Enemy AI", 
                        "detectionRange": 15.0, 
                        "loseTargetRange": 20.0, 
                        "moveSpeed": 5.0, 
                        "attackRange": 3.5,
                        "attackDamage": 12.0, 
                        "attackCooldown": 0.8, 
                        "patrolPoint": [0, 0.75, -8],
                        "initialState": "IDLE"
                    },
                    { 
                        "type": "Collision", 
                        "radius": 1.5, 
                        "isStatic": false, 
                        "canCollideWithWalls": true, 
                        "canCollideWithPlayer": true 
                    },
                    { "type": "Health", "maxHealth": 60.0, "currentHealth": 60.0, "destroyOnDeath": true }
                ]
            },
            
            // WALLS (boundaries)
            {
                "name": "Left Wall",
                "position": [-15, 2, 0],
                "scale": [1, 4, 15],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 4.0, "isStatic": true }
                ]
            },
            {
                "name": "Right Wall",
                "position": [15, 2, 0],
                "scale": [1, 4, 15],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 4.0, "isStatic": true }
                ]
            },
            {
                "name": "Back Wall",
                "position": [0, 2, -10],
                "scale": [15, 4, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 4.0, "isStatic": true }
                ]
            },
            {
                "name": "Front Wall",
                "position": [0, 2, 10],
                "scale": [15, 4, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 4.0, "isStatic": true }
                ]
            },
            
            // OBSTACLE (in the center)
            {
                "name": "Central Obstacle",
                "position": [0, 1.5, 0],
                "scale": [3, 3, 3],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 3.0, "isStatic": true }
                ]
            }
        ]
    }
}
