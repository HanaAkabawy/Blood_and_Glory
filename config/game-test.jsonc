                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [1.0, 0.2, 0.2, 1.0]
                },
                "wall": {
                    "type": "textured",
