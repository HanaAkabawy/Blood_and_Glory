{
    "start-scene": "play",
    "window": {
        "title": "Blood and Glory - COMBAT & AI Test Scene",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/sepia.frag" 
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "smile": "assets/textures/smile.png",
                "wood": "assets/textures/wood.jpg",
                "grass": "assets/textures/grass_ground_d.jpg"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "sphere": "assets/models/sphere.obj"
            },
            "samplers": {
                "default": {}
            },
            "materials": {
                "ground": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "texture": "grass",
                    "sampler": "default",
                    "tint": [0.8, 1.0, 0.8, 1.0]
                },
                "player": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "texture": "smile",
                    "sampler": "default",
                    "tint": [0.3, 0.6, 1.0, 1.0]
                },
                "enemy": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "tint": [1.0, 0.2, 0.2, 1.0]
                },
                "wall": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "texture": "wood",
                    "sampler": "default",
                    "tint": [0.7, 0.5, 0.3, 1.0]
                },
                "orbit_cam_target": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": { "enabled": true },
                        "depthTesting": { "enabled": true }
                    },
                    "transparent": false,
                    "tint": [0.0, 1.0, 1.0, 1.0]
                }
            }
        },
        "world": [
            {
                "name": "Fixed Camera",
                "position": [0, 0, 30],
                "rotation": [0, 0, 0],
                "components": [{ "type": "Camera" }]
            },
            // The Orbit Camera follows the Player (target: "Player")
            {
                "name": "Orbit Camera",
                "position": [0, 10, 10], 
                "rotation": [0, 0, 0],
                "components": [
                    { "type": "Camera" },
                    { "type": "Orbit Camera Controller", "target": "Player", "distance": 15.0, "pitch": 45.0, "zoomSensitivity": 2.0 } 
                ]
            },
            {
                "name": "Orbit Target",
                "position": [0, 5, 0],
                "scale": [1, 1, 1],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "orbit_cam_target" }
                ]
            },

            /* -------- PLAYER (WASD controlled, Combat Source) -------- */
            {
                "name": "Player",
                "position": [0, 0, 0], // Central starting position (moved to ground level so attack range works)
                "scale": [2, 2, 2],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "player" },
                    // Component for WASD movement control
                    { "type": "Player Controller", "movementSpeed": 10.0, "rotationSpeed": 10.0, "sprintMultiplier": 1.5 }, 
                    { "type": "Collision", "radius": 2.0, "isStatic": false, "canCollideWithWalls": true, "canCollideWithEnemies": true },
                    // Health Component setup
                    { "type": "Health", "maxHealth": 100.0, "currentHealth": 100.0 },
                    // Component to trigger PlayerCombatSystem logic
                    { 
                        "type": "Click Attack", 
                        "damage": 100.0,
                        "range": 5.0,
                        "attackCooldown": 0.0
                    }
                ]
            },

            /* -------- ENEMIES (AI & COMBAT TARGETS) -------- */
            {
                "name": "Enemy 1",
                "position": [2, 0, 0], 
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "enemy" },
                    // Enemy AI Component setup for state machine test
                    { 
                        "type": "Enemy AI", 
                        "detectionRange": 10.0, "loseTargetRange": 15.0, "moveSpeed": 3.0, "attackRange": 3.0, "attackDamage": 10.0, "attackCooldown": 1.5, "initialState": "IDLE", "idleTime": 1.0,
                        "patrolPoint": [-15, 0, 0] 
                    },
                    { "type": "Collision", "radius": 1.5, "isStatic": false, "canCollideWithWalls": true, "canCollideWithPlayer": true },
                    // Health set to be destroyed quickly for DestructionSystem test
                    { "type": "Health", "maxHealth": 30.0, "currentHealth": 1.0, "destroyOnDeath": true } 
                ]
            },
            {
                "name": "Enemy 2",
                "position": [10, 0, 0],
                "scale": [2, 2, 2],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "sphere", "material": "enemy" },
                    // Enemy AI Component setup for state machine test
                    { 
                        "type": "Enemy AI", 
                        "detectionRange": 20.0, "loseTargetRange": 30.0, "moveSpeed": 4.0, "attackDamage": 15.0, "attackCooldown": 0.5, 
                        "patrolPoint": [15, 0, 0], 
                        "initialState": "IDLE" 
                    },
                    { "type": "Collision", "radius": 2.0, "isStatic": false, "canCollideWithWalls": true, "canCollideWithPlayer": true },
                    { "type": "Health", "maxHealth": 50.0, "currentHealth": 1.0, "destroyOnDeath": true }
                ]
            },

            /* -------- WORLD (Unchanged) -------- */
            {
                "name": "Ground",
                "position": [0, -5, 0],
                "scale": [60, 1, 10],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "ground" },
                    { "type": "Collision", "radius": 60.0, "isStatic": true }
                ]
            },
            {
                "name": "Left Wall",
                "position": [-30, 0, 0],
                "scale": [2, 10, 10],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 6.0, "isStatic": true }
                ]
            },
            {
                "name": "Right Wall",
                "position": [30, 0, 0],
                "scale": [2, 10, 10],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 6.0, "isStatic": true }
                ]
            },
            {
                "name": "Obstacle 1",
                "position": [0, 1, 0],
                "scale": [3, 3, 3],
                "components": [
                    { "type": "Mesh Renderer", "mesh": "cube", "material": "wall" },
                    { "type": "Collision", "radius": 3.0, "isStatic": true }
                ]
            }
        ]
    }
}