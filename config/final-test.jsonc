{
    "start-scene": "play",
    "window": {
        "title": "Blood and Glory - Final Test Arena",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "sphere": "assets/models/sphere.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers": {
                "default": {}
            },
            "materials": {
                "ground": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [0.3, 0.6, 0.3, 1.0]
                },
                "player": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [0.2, 0.5, 1.0, 1.0]
                },
                "enemy": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [1.0, 0.2, 0.2, 1.0]
                },
                "wall": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [0.6, 0.4, 0.2, 1.0]
                },
                "obstacle": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [0.5, 0.5, 0.5, 1.0]
                }
            }
        },
        "world": [
            // ========== CAMERA ==========
            {
                "position": [0, 15, 25],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Orbit Camera Controller",
                        "distance": 25.0,
                        "minDistance": 10.0,
                        "maxDistance": 50.0,
                        "zoomSensitivity": 2.0,
                        "orbitSensitivity": 0.01,
                        "pitch": 45.0,
                        "yaw": 0.0
                    }
                ]
            },
            
            // ========== PLAYER ==========
            {
                "position": [0, 0, 0],
                "scale": [2, 2, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "player"
                    },
                    {
                        "type": "Player Controller",
                        "movementSpeed": 8.0,
                        "rotationSpeed": 10.0,
                        "sprintMultiplier": 2.0
                    },
                    {
                        "type": "Collision",
                        "radius": 2.0,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithEnemies": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 100.0,
                        "currentHealth": 100.0
                    }
                ]
            },
            
            // ========== GROUND (Large flat plane) ==========
            {
                "position": [0, -3, 0],
                "scale": [80, 1, 80],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "ground"
                    },
                    {
                        "type": "Collision",
                        "radius": 80.0,
                        "isStatic": true
                    }
                ]
            },
            
            // ========== ARENA WALLS (Form a rectangle around the arena) ==========
            // North Wall
            {
                "position": [0, 4, -30],
                "scale": [60, 8, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 5.0,
                        "isStatic": true
                    }
                ]
            },
            // South Wall
            {
                "position": [0, 4, 30],
                "scale": [60, 8, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 5.0,
                        "isStatic": true
                    }
                ]
            },
            // East Wall
            {
                "position": [30, 4, 0],
                "scale": [2, 8, 60],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 5.0,
                        "isStatic": true
                    }
                ]
            },
            // West Wall
            {
                "position": [-30, 4, 0],
                "scale": [2, 8, 60],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 5.0,
                        "isStatic": true
                    }
                ]
            },
            
            // ========== OBSTACLES (Scattered around arena) ==========
            // Center obstacle
            {
                "position": [5, 2, 5],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "obstacle"
                    },
                    {
                        "type": "Collision",
                        "radius": 3.0,
                        "isStatic": true
                    }
                ]
            },
            {
                "position": [-8, 2, -8],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "obstacle"
                    },
                    {
                        "type": "Collision",
                        "radius": 3.0,
                        "isStatic": true
