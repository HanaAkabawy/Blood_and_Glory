            // Enemy 5 - Boss in corner
            {
                "position": [18, 18, 0],
                "scale": [3, 3, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 25.0,
