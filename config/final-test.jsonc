                        "material": "obstacle"
                    },
                    {
                        "type": "Collision",
                        "radius": 3.5,
                        "isStatic": true
                    }
                ]
            },
            
            // ========== ENEMIES ==========
            // Enemy 1 - Close and weak (Good first target)
            {
                "position": [8, 0, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 15.0,
                        "loseTargetRange": 20.0,
                        "moveSpeed": 3.0,
                        "attackRange": 3.0,
                        "attackDamage": 10.0,
                        "attackCooldown": 1.5
                    },
                    {
                        "type": "Collision",
                        "radius": 1.5,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 25.0,
                        "currentHealth": 25.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Enemy 2 - Medium threat
            {
                "position": [-10, 0, 0],
                "scale": [2, 2, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 18.0,
