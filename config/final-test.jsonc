                    },
                    {
                        "type": "Health",
                        "maxHealth": 50.0,
                        "currentHealth": 50.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Enemy 3 - Far but dangerous
            {
                "position": [0, 15, 0],
                "scale": [2.5, 2.5, 2.5],
