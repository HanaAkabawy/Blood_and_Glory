            // Enemy 4 - Fast and aggressive
            {
                "position": [0, -12, 0],
                "scale": [1.2, 1.2, 1.2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 22.0,
