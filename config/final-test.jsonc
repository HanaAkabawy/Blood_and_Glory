            // Enemy 6 - Another fast one
            {
                "position": [-15, -10, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 20.0,
                        "loseTargetRange": 25.0,
