{
    "start-scene": "play",
    "window": {
        "title": "Blood and Glory - Complete Game",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                },
                "lit": {
                    "vs": "assets/shaders/lit.vert",
                    "fs": "assets/shaders/lit.frag"
                }
            },
            "textures": {
                "moon": "assets/textures/moon.jpg",
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "glass": "assets/textures/glass-panels.png",
                "monkey": "assets/textures/monkey.png",
                "smile": "assets/textures/smile.png",
                "gladiator_armor": "assets/textures/gladiator_armor.tga",
                "enemy": "assets/textures/orc.png",
                "torch_diffuse": "assets/textures/Diffuse.png",
                "torch_emissive": "assets/textures/Emission.png",
                "colesseum": "assets/textures/colesseum.jpg"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "colesseum": "assets/models/colesseum.obj",
                "monkey": "assets/models/monkey.obj",
                "plane": "assets/models/plane.obj",
                "sphere": "assets/models/sphere.obj",
                "gladiator": "assets/models/gladiator.obj",
                "enemy": "assets/models/fatboi.obj",
                "torch": "assets/models/Torch.obj"
            },
            "samplers": {
                "default": {},
                "pixelated": {
                    "MAG_FILTER": "GL_NEAREST"
                }
            },
            "materials": {
                "metal": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "tint": [0.45, 0.4, 0.5, 1]
                },
                "player_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "gladiator_armor",
                    "sampler": "default",
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "shininess": 16.0
                },
                "enemy_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "enemy",
                    "sampler": "default",
                    "tint": [1.0, 0.8, 0.8, 1.0],
                    "shininess": 8.0
                },
                "arena_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "colesseum",
                    "sampler": "default",
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "shininess": 32.0
                },
                "ground_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "grass",
                    "sampler": "default",
                    "tint": [0.8, 0.8, 0.8, 1.0],
                    "shininess": 4.0
                },
                "torch_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "torch_diffuse",
                    "emissiveMap": "torch_emissive",
                    "sampler": "default",
                    "tint": [1.0, 1.0, 1.0, 1.0],
                    "shininess": 32.0
                },
                "wall_mat": {
                    "type": "lit",
                    "shader": "lit",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": false
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "texture": "wood",
                    "sampler": "default",
                    "tint": [0.6, 0.5, 0.4, 1.0],
                    "shininess": 8.0
                }
            }
        },
        "world": [
            // ========== CAMERA WITH ORBIT CONTROLLER ==========
            {
                "name": "main-camera",
                "position": [0, 5, 15],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Orbit Camera Controller",
                        "distance": 12.0,
                        "minDistance": 5.0,
                        "maxDistance": 25.0,
                        "zoomSensitivity": 1.5,
                        "orbitSensitivity": 0.01,
                        "yaw": 0.0,
                        "pitch": 35.0,
                        "minPitch": 10.0,
                        "maxPitch": 80.0,
                        "enableMouseOrbit": true
                    }
                ]
            },

            // ========== LIGHTING SYSTEM ==========
            // Directional sunlight
            {
                "name": "sun",
                "position": [10, 20, 5],
                "rotation": [-45, 30, 0],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "directional",
                        "color": [1.0, 0.95, 0.8]
                    }
                ]
            },

            // Torches around the arena for atmospheric lighting
            {
                "name": "torch-nw",
                "position": [-12, 1, -12],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.5, 0.1],
                        "attenuation": [0.5, 0.09, 0.032]
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "torch",
                        "material": "torch_mat"
                    }
                ]
            },
            {
                "name": "torch-ne",
                "position": [12, 1, -12],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.5, 0.1],
                        "attenuation": [0.5, 0.09, 0.032]
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "torch",
                        "material": "torch_mat"
                    }
                ]
            },
            {
                "name": "torch-sw",
                "position": [-12, 1, 12],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.5, 0.1],
                        "attenuation": [0.5, 0.09, 0.032]
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "torch",
                        "material": "torch_mat"
                    }
                ]
            },
            {
                "name": "torch-se",
                "position": [12, 1, 12],
                "components": [
                    {
                        "type": "Light",
                        "lightType": "point",
                        "color": [1.0, 0.5, 0.1],
                        "attenuation": [0.5, 0.09, 0.032]
                    },
                    {
                        "type": "Mesh Renderer",
                        "mesh": "torch",
                        "material": "torch_mat"
                    }
                ]
            },

            // ========== PLAYER (GLADIATOR) ==========
            {
                "name": "player",
                "position": [0, 0, 0],
                "rotation": [0, 0, 0],
                "scale": [2.0, 2.0, 2.0],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "gladiator",
                        "material": "player_mat"
                    },
                    {
                        "type": "Player Controller",
                        "movementSpeed": 6.0,
                        "rotationSpeed": 12.0,
                        "smoothRotation": true
                    },
                    {
                        "type": "Collision",
                        "radius": 1.2,
                        "offset": [0, 0, 0],
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": false,
                        "canCollideWithEnemies": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 100.0,
                        "currentHealth": 100.0,
                        "isAlive": true,
                        "destroyOnDeath": false
                    }
                ]
            },

            // ========== ENEMIES (ORCS) ==========
            // Enemy 1 - Close to player
            {
                "name": "enemy",
                "position": [5, 0, 3],
                "rotation": [0, 180, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "enemy",
                        "material": "enemy_mat"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 10.0,
                        "loseTargetRange": 15.0,
                        "moveSpeed": 3.0,
                        "attackRange": 2.0,
                        "attackDamage": 10.0,
                        "attackCooldown": 1.0
