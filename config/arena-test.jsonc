{
    "start-scene": "play",
    "window": {
        "title": "Blood and Glory - Combat Arena",
        "size": {
            "width": 1280,
            "height": 720
        },
        "fullscreen": false
    },
    "scene": {
        "renderer": {
            "sky": "assets/textures/sky.jpg",
            "postprocess": "assets/shaders/postprocess/vignette.frag"
        },
        "assets": {
            "shaders": {
                "tinted": {
                    "vs": "assets/shaders/tinted.vert",
                    "fs": "assets/shaders/tinted.frag"
                },
                "textured": {
                    "vs": "assets/shaders/textured.vert",
                    "fs": "assets/shaders/textured.frag"
                }
            },
            "textures": {
                "grass": "assets/textures/grass_ground_d.jpg",
                "wood": "assets/textures/wood.jpg",
                "smile": "assets/textures/smile.png",
                "moon": "assets/textures/moon.jpg",
                "monkey": "assets/textures/monkey.png",
                "color-grid": "assets/textures/color-grid.png"
            },
            "meshes": {
                "cube": "assets/models/cube.obj",
                "sphere": "assets/models/sphere.obj",
                "plane": "assets/models/plane.obj"
            },
            "samplers": {
                "default": {}
            },
            "materials": {
                "ground": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "texture": "grass",
                    "sampler": "default",
                    "tint": [1.0, 1.0, 1.0, 1.0]
                },
                "player": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "texture": "smile",
                    "sampler": "default",
                    "tint": [1.0, 1.0, 1.0, 1.0]
                },
                "enemy": {
                    "type": "tinted",
                    "shader": "tinted",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "tint": [1.0, 0.2, 0.2, 1.0]
                },
                "wall": {
                    "type": "textured",
                    "shader": "textured",
                    "pipelineState": {
                        "faceCulling": {
                            "enabled": true
                        },
                        "depthTesting": {
                            "enabled": true
                        }
                    },
                    "transparent": false,
                    "texture": "wood",
                    "sampler": "default",
                    "tint": [0.6, 0.4, 0.2, 1.0]
                }
            }
        },
        "world": [
            // Camera with orbit controller
            {
                "position": [0, 5, 20],
                "components": [
                    {
                        "type": "Camera"
                    },
                    {
                        "type": "Orbit Camera Controller",
                        "distance": 20.0,
                        "minDistance": 8.0,
                        "maxDistance": 40.0,
                        "zoomSensitivity": 2.0,
                        "orbitSensitivity": 0.01,
                        "pitch": 45.0,
                        "yaw": 0.0
                    }
                ]
            },
            
            // Player - Blue Sphere at center
            {
                "position": [0, 0, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "player"
                    },
                    {
                        "type": "Player Controller",
                        "movementSpeed": 6.0,
                        "rotationSpeed": 10.0,
                        "sprintMultiplier": 2.0
                    },
                    {
                        "type": "Collision",
                        "radius": 1.5,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithEnemies": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 100.0,
                        "currentHealth": 100.0
                    }
                ]
            },
            
            // Ground Plane
            {
                "position": [0, -2, 0],
                "scale": [60, 0.5, 60],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "ground"
                    },
                    {
                        "type": "Collision",
                        "radius": 60.0,
                        "isStatic": true
                    }
                ]
            },
            
            // Enemy 1 - Close and weak (Right side)
            {
                "position": [10, 0, 0],
                "scale": [1.5, 1.5, 1.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 20.0,
                        "loseTargetRange": 25.0,
                        "moveSpeed": 3.0,
                        "attackRange": 3.0,
                        "attackDamage": 10.0,
                        "attackCooldown": 1.5
                    },
                    {
                        "type": "Collision",
                        "radius": 1.5,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 30.0,
                        "currentHealth": 30.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Enemy 2 - Medium distance (Left side)
            {
                "position": [-10, 0, 0],
                "scale": [2, 2, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 18.0,
                        "loseTargetRange": 23.0,
                        "moveSpeed": 4.0,
                        "attackRange": 3.5,
                        "attackDamage": 15.0,
                        "attackCooldown": 1.2
                    },
                    {
                        "type": "Collision",
                        "radius": 2.0,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 50.0,
                        "currentHealth": 50.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Enemy 3 - Far and tough (Top)
            {
                "position": [0, 15, 0],
                "scale": [2.5, 2.5, 2.5],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 25.0,
                        "loseTargetRange": 30.0,
                        "moveSpeed": 2.5,
                        "attackRange": 4.0,
                        "attackDamage": 20.0,
                        "attackCooldown": 2.0
                    },
                    {
                        "type": "Collision",
                        "radius": 2.5,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 75.0,
                        "currentHealth": 75.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Enemy 4 - Fast and aggressive (Bottom)
            {
                "position": [0, -12, 0],
                "scale": [1.2, 1.2, 1.2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "sphere",
                        "material": "enemy"
                    },
                    {
                        "type": "Enemy AI",
                        "detectionRange": 22.0,
                        "loseTargetRange": 27.0,
                        "moveSpeed": 5.5,
                        "attackRange": 2.5,
                        "attackDamage": 12.0,
                        "attackCooldown": 0.8
                    },
                    {
                        "type": "Collision",
                        "radius": 1.2,
                        "isStatic": false,
                        "canCollideWithWalls": true,
                        "canCollideWithPlayer": true
                    },
                    {
                        "type": "Health",
                        "maxHealth": 25.0,
                        "currentHealth": 25.0,
                        "destroyOnDeath": true
                    }
                ]
            },
            
            // Wall obstacles - Top right
            {
                "position": [15, 10, 0],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 4.0,
                        "isStatic": true
                    }
                ]
            },
            
            // Wall obstacles - Top left
            {
                "position": [-15, 10, 0],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 4.0,
                        "isStatic": true
                    }
                ]
            },
            
            // Wall obstacles - Bottom right
            {
                "position": [15, -10, 0],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 4.0,
                        "isStatic": true
                    }
                ]
            },
            
            // Wall obstacles - Bottom left
            {
                "position": [-15, -10, 0],
                "scale": [3, 4, 3],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 4.0,
                        "isStatic": true
                    }
                ]
            },
            
            // Center obstacle
            {
                "position": [0, 0, 0],
                "scale": [2, 8, 2],
                "components": [
                    {
                        "type": "Mesh Renderer",
                        "mesh": "cube",
                        "material": "wall"
                    },
                    {
                        "type": "Collision",
                        "radius": 3.0,
                        "isStatic": true
                    }
                ]
            }
        ]
    }
}
